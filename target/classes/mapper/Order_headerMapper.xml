<?xml version="1.0" encoding="UTF-8"?>
 <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
          "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
          
<mapper namespace="com.hkd.mapper.order_headerMapper">

<!-- 映射 -->
<resultMap id="OrderHeaderResultMap" type="order_header">
    <id property="order_id" column="id"/>
    <result property="user_id" column="user_id"/>
    <result property="address" column="address"/>
    <result property="order_time" column="order_time"/>
    <result property="status" column="STATUS"/>
</resultMap>

<!-- 插入 -->
<insert id="insertoh" keyProperty="order_id" useGeneratedKeys="true">

insert into  order_header(user_id,address,order_time,status) values(#{user_id},#{address},#{order_time},'00')


</insert>


<!-- 查询本人订单 -->

<select id="selectOrdersByUid" resultMap="OrderHeaderResultMap">

	SELECT * FROM order_header WHERE user_id=${uid} ORDER BY order_time DESC;

</select>

<!-- 更新订单状态 -->
<update id="updateStatus">

    UPDATE order_header SET status=#{status} WHERE id=#{order_id}

</update>    
</mapper>