<?xml version="1.0" encoding="UTF-8"?>
 <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
          "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hkd.mapper.MemberMapper">

<!-- Member映射 -->
<resultMap type="Member" id="MemberResultMapper">

  
    <result property="number" column="member_number"/>
    <result property="level" column="member_level"/>
    <result property="points" column="points"/>
    <result property="discount_rate" column="discount_rate"/>
    <result property="tel" column="tel"/>
    

</resultMap>

<!-- 查询所有会员信息 -->
<select id="selectAllMembers" resultMap="MemberResultMapper">
    SELECT * FROM member_discount_view
</select>


<!-- 根据会员编号查询会员信息 -->
<select id="getMemberByid" resultMap="MemberResultMapper" parameterType="int">
    SELECT * FROM member_discount_view WHERE member_number = #{number}
</select>


<!-- 注册会员 -->
<insert id="insertMember" >
   insert into member(tel) values (#{tel});
    
 </insert>   
    
    
<!-- 更新积分 -->
<update id="updatePoints">
    UPDATE member
    SET points = #{point}+points
    WHERE member_number = #{id}
</update>    
    
   
</mapper>