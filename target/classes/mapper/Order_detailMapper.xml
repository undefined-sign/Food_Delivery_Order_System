<?xml version="1.0" encoding="UTF-8"?>
 <!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
          "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.hkd.mapper.order_detailMapper">

<!-- 插入 -->
<insert id="insertod" >

insert into  order_detail(order_id,menu_id,quantity,price) values(#{order_id},#{dish_id},#{num},#{price})


</insert>

<!-- 删除操作 -->
<delete id="del" >

delete from order_detail where order_id=#{order_id} and menu_id=#{dish_id}

</delete>


</mapper>